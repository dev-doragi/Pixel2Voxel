<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Pixel2Voxel</AssemblyName>
    <Product>Pixel2Voxel</Product>
    <Description>Six-view pixel-to-voxel reconstruction studio</Description>
    <ApplicationIcon>Assets\Pixel2Voxel.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Pixel2Voxel.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelVoxel.Core\PixelVoxel.Core.csproj" />
    <ProjectReference Include="..\PixelVoxel.Rendering\PixelVoxel.Rendering.csproj" />
    <ProjectReference Include="..\PixelVoxel.Imaging\PixelVoxel.Imaging.csproj" />
    <ProjectReference Include="..\PixelVoxel.Export\PixelVoxel.Export.csproj" />
  </ItemGroup>
</Project>
