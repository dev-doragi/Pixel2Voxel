<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelVoxel.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <Color x:Key="AppBackgroundColor">#0B0E14</Color>
    <Color x:Key="PanelBackgroundColor">#121722</Color>
    <Color x:Key="SurfaceColor">#181E2B</Color>
    <Color x:Key="SurfaceHoverColor">#20283A</Color>
    <Color x:Key="AccentColor">#7C6FF7</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#293143" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5FA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#929BAD" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#090C12" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#41C98E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F0B35A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F06B78" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="#0E121B" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    </Style>
    <Style Selector="ToggleButton:checked">
      <Setter Property="Background" Value="#3B3478" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.rail">
      <Setter Property="Background" Value="{StaticResource RailBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    </Style>
    <Style Selector="ToggleButton.rail-item">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="54" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,0" />
    </Style>
    <Style Selector="ToggleButton.rail-item:checked">
      <Setter Property="Background" Value="#28234D" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.toolbar">
      <Setter Property="Background" Value="#0E121B" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    </Style>
    <Style Selector="ToggleButton.step">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="ToggleButton.step:checked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="10,7" />
    </Style>
  </Application.Styles>
</Application>
