<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelVoxel.App.ViewModels"
        xmlns:services="using:PixelVoxel.App.Services"
        xmlns:views="using:PixelVoxel.App.Views"
        x:Class="PixelVoxel.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="600"
        Title="{Binding WindowTitle}"
        KeyDown="Window_KeyDown">
  <Grid RowDefinitions="Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="File">
        <MenuItem Header="New Project" Click="NewProject_Click" />
        <MenuItem Header="Open Project..." Click="OpenProject_Click" />
        <MenuItem Header="Save Project" IsEnabled="{Binding HasDocument}" Click="SaveProject_Click" />
        <MenuItem Header="Save Project As..." IsEnabled="{Binding HasDocument}" Click="SaveProjectAs_Click" />
        <Separator />
        <MenuItem Header="Import 6×1 Sheet..." Click="OpenHorizontalSheet_Click" />
      </MenuItem>
      <MenuItem Header="Edit">
        <MenuItem Header="Undo" IsEnabled="{Binding CanUndo}" Click="Undo_Click" />
        <MenuItem Header="Redo" IsEnabled="{Binding CanRedo}" Click="Redo_Click" />
        <Separator />
        <MenuItem Header="Delete Selection" Click="DeleteSelection_Click" />
        <MenuItem Header="Clear Selection" Click="ClearSelection_Click" />
      </MenuItem>
      <MenuItem Header="View">
        <MenuItem Header="Pixel 2:1" Tag="Pixel2To1" Click="SelectPreset_Click" />
        <MenuItem Header="True Isometric" Tag="TrueIsometric" Click="SelectPreset_Click" />
        <MenuItem Header="Front" Tag="Front" Click="SelectPreset_Click" />
        <MenuItem Header="Right" Tag="Right" Click="SelectPreset_Click" />
        <MenuItem Header="Top" Tag="Top" Click="SelectPreset_Click" />
      </MenuItem>
      <MenuItem Header="Model" />
      <MenuItem Header="Export">
        <MenuItem Header="Export Current View PNG..."
                  IsEnabled="{Binding CanExport}"
                  Click="ExportCurrentView_Click" />
        <MenuItem Header="Export Direction Sheet..."
                  IsEnabled="{Binding CanExport}"
                  Click="ExportDirectionSheet_Click" />
      </MenuItem>
      <MenuItem Header="Help" />
    </Menu>

    <Grid Grid.Row="1" ColumnDefinitions="430,*,340">
      <Border Grid.Column="0"
              Padding="14"
              BorderBrush="{DynamicResource ThemeBorderLowBrush}"
              BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="Import Alignment" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*">
              <Border Grid.Column="0" Margin="0,0,4,0" Padding="10"
                      BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="PngDrop_DragOver"
                      DragDrop.Drop="SheetDrop_Drop">
                <StackPanel Spacing="6">
                  <TextBlock Text="6×1 Sheet Drop" FontWeight="SemiBold" />
                  <Button Click="OpenHorizontalSheet_Click" Content="Choose Sheet..." />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Margin="4,0,0,0" Padding="10"
                      BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="PngDrop_DragOver"
                      DragDrop.Drop="SeparateDrop_Drop">
                <StackPanel Spacing="6">
                  <TextBlock Text="Separate PNG Drop" FontWeight="SemiBold" />
                  <Button Click="ChooseSeparateFiles_Click" Content="Choose PNGs..." />
                </StackPanel>
              </Border>
            </Grid>

            <Expander Header="Assign separate files manually">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                  <Button Grid.Row="0" Tag="Front" Click="SelectFaceFile_Click" Content="Front" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding FrontPath}" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Row="1" Tag="Right" Click="SelectFaceFile_Click" Content="Right" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding RightPath}" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Row="2" Tag="Back" Click="SelectFaceFile_Click" Content="Back" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding BackPath}" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Row="3" Tag="Left" Click="SelectFaceFile_Click" Content="Left" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding LeftPath}" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Row="4" Tag="Top" Click="SelectFaceFile_Click" Content="Top" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding TopPath}" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Row="5" Tag="Bottom" Click="SelectFaceFile_Click" Content="Bottom" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding BottomPath}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Button Click="ReconstructSeparate_Click" Content="Inspect Assigned Views" />
              </StackPanel>
            </Expander>

            <Grid ColumnDefinitions="*,Auto">
              <ComboBox ItemsSource="{Binding RecentImports}"
                        SelectedItem="{Binding SelectedRecentImport}"
                        PlaceholderText="Recent imports">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="services:RecentImportSettings">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Margin="8,0,0,0" Click="OpenRecentImport_Click" Content="Open" />
            </Grid>

            <ItemsControl ItemsSource="{Binding ImportFaceSlots}" IsVisible="{Binding IsImportDraftLoaded}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ImportFaceSlotViewModel">
                  <Border Margin="3" Padding="7"
                          BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="ImportFaceCard_DragOver"
                          DragDrop.Drop="ImportFaceCard_Drop">
                    <StackPanel Spacing="5">
                      <Border Padding="4" Background="#323741"
                              PointerPressed="ImportFaceHeader_PointerPressed">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding TargetFace}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="↕ drag" Opacity="0.65" />
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding SourceName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      <Grid Height="112" ClipToBounds="True">
                        <views:CheckerboardControl />
                        <Image Source="{Binding PreviewBitmap}" Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="None" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <CheckBox IsChecked="{Binding FlipHorizontal}" Content="Flip H" />
                        <CheckBox IsChecked="{Binding FlipVertical}" Content="Flip V" />
                      </StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto,*">
                        <TextBlock VerticalAlignment="Center" Text="X" />
                        <NumericUpDown Grid.Column="1" Margin="3,0" Minimum="-4096" Maximum="4096"
                                       Value="{Binding OffsetX}" FormatString="0" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Y" />
                        <NumericUpDown Grid.Column="3" Margin="3,0" Minimum="-4096" Maximum="4096"
                                       Value="{Binding OffsetY}" FormatString="0" />
                      </Grid>
                      <TextBlock Text="{Binding DiagnosticText}" FontSize="10" TextWrapping="Wrap" />
                      <TextBlock Text="Blocking error" Foreground="#FFFF5A5A" FontSize="10" IsVisible="{Binding HasError}" />
                      <TextBlock Text="Clipping warning" Foreground="#FFFFB347" FontSize="10" IsVisible="{Binding HasWarning}" />
                      <Button Tag="{Binding TargetFace}" Click="ResetImportFace_Click" Content="Reset Face" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,*,*" IsVisible="{Binding IsImportDraftLoaded}">
              <Button Grid.Column="0" Margin="0,0,4,0" Click="ResetAllImport_Click" Content="Reset All" />
              <Button Grid.Column="1" Margin="4,0" Click="Reimport_Click" Content="Re-import" />
              <Button Grid.Column="2" Margin="4,0,0,0" IsEnabled="{Binding CanApplyImport}"
                      Click="ApplyImport_Click" Content="Apply / Reconstruct" />
            </Grid>

            <Separator Margin="0,6" />
            <TextBlock Text="Import diagnostics" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ImportSummary}" FontFamily="Consolas" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="ViewportHost"
              Grid.Column="1"
              Margin="12"
              ClipToBounds="True"
              Background="#141820"
              BorderBrush="{DynamicResource ThemeBorderMidBrush}"
              BorderThickness="1"
              PointerPressed="Viewport_PointerPressed"
              PointerMoved="Viewport_PointerMoved"
              PointerReleased="Viewport_PointerReleased"
              PointerExited="Viewport_PointerExited"
              PointerWheelChanged="Viewport_PointerWheelChanged">
        <Grid>
          <views:SilkVoxelViewportControl />
          <views:CpuPixelViewportControl Source="{Binding ViewportBitmap}"
                                         ManualScale="{Binding ManualZoomScale}"
                                         IsVisible="{Binding IsCpuFallbackActive}" />
          <views:RotationGizmoControl x:Name="RotationGizmo"
                                      Width="180" Height="190"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding IsViewMode}"
                                      IsHitTestVisible="False" />
          <Border HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="12,8"
                  Background="#B0141820"
                  IsVisible="{Binding HasViewportMessage}">
            <TextBlock Margin="12"
                       Text="{Binding ViewportMessage}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Padding="14"
              BorderBrush="{DynamicResource ThemeBorderLowBrush}"
              BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="Voxel Editor" FontSize="16" FontWeight="SemiBold" />
            <UniformGrid Columns="5">
              <Button Margin="2" Tag="View" Click="SelectEditTool_Click" Content="View" />
              <Button Margin="2" Tag="Add" Click="SelectEditTool_Click" Content="Add" />
              <Button Margin="2" Tag="Erase" Click="SelectEditTool_Click" Content="Erase" />
              <Button Margin="2" Tag="Paint" Click="SelectEditTool_Click" Content="Paint" />
              <Button Margin="2" Tag="Select" Click="SelectEditTool_Click" Content="Select" />
            </UniformGrid>
            <TextBlock Text="Current color" />
            <ColorPicker Color="{Binding EditColor}" IsAlphaEnabled="False" />
            <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Opacity="0.72" />
            <UniformGrid Columns="3">
              <Button Margin="2" Tag="-X" Click="MoveSelection_Click" Content="−X" />
              <Button Margin="2" Tag="+X" Click="MoveSelection_Click" Content="+X" />
              <Button Margin="2" Tag="-Y" Click="MoveSelection_Click" Content="−Y" />
              <Button Margin="2" Tag="+Y" Click="MoveSelection_Click" Content="+Y" />
              <Button Margin="2" Tag="-Z" Click="MoveSelection_Click" Content="−Z" />
              <Button Margin="2" Tag="+Z" Click="MoveSelection_Click" Content="+Z" />
            </UniformGrid>
            <Button Click="DeleteSelection_Click" Content="Delete Selection" />
            <Expander Header="Resize Volume">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                  <TextBlock VerticalAlignment="Center" Text="W" />
                  <NumericUpDown Grid.Column="1" Margin="3,0" Minimum="1" Maximum="1048576" Value="{Binding ResizeWidth}" FormatString="0" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="H" />
                  <NumericUpDown Grid.Column="3" Margin="3,0" Minimum="1" Maximum="1048576" Value="{Binding ResizeHeight}" FormatString="0" />
                  <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="D" />
                  <NumericUpDown Grid.Column="5" Margin="3,0" Minimum="1" Maximum="1048576" Value="{Binding ResizeDepth}" FormatString="0" />
                </Grid>
                <Button Click="ResizeVolume_Click" Content="Apply Resize" />
              </StackPanel>
            </Expander>
            <TextBlock Text="Left-drag: active tool · Shift+Paint: all faces · Right-drag: orbit · Middle-drag: pan"
                       TextWrapping="Wrap" Opacity="0.72" />

            <Separator Margin="0,6" />
            <TextBlock Text="Camera" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CameraSummary}" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding CameraFaceSnapEnabled}"
                      Content="Face-aligned snap (2°)" />
            <UniformGrid Columns="2" Rows="3">
              <Button Margin="2" Tag="Pixel2To1" Click="SelectPreset_Click" Content="Pixel 2:1" />
              <Button Margin="2" Tag="TrueIsometric" Click="SelectPreset_Click" Content="True Iso" />
              <Button Margin="2" Tag="Front" Click="SelectPreset_Click" Content="Front" />
              <Button Margin="2" Tag="Right" Click="SelectPreset_Click" Content="Right" />
              <Button Margin="2" Tag="Top" Click="SelectPreset_Click" Content="Top" />
              <Button Margin="2" Click="LoadSavedDefault_Click" Content="Saved Default" />
            </UniformGrid>
            <UniformGrid Columns="2">
              <Button Margin="2" Click="EnterFreeView_Click" Content="Free Rotation" />
              <Button Margin="2" Click="ResetView_Click" Content="Reset View" />
            </UniformGrid>
            <UniformGrid Columns="2">
              <Button Margin="2" Click="ResetCamera_Click" Content="Reset Camera" />
              <Button Margin="2" Click="ResetObject_Click" Content="Reset Object" />
            </UniformGrid>
            <Button Click="SaveCurrentAsDefault_Click" Content="Save Current as Default" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock VerticalAlignment="Center" Text="Zoom" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="{Binding ZoomSummary}" />
                <Button Click="FitZoom_Click" Content="Fit" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Right-drag: orbit · Middle-drag: pan · Wheel: integer zoom"
                       TextWrapping="Wrap" Opacity="0.72" />

            <Separator Margin="0,6" />
            <TextBlock Text="Animation" FontSize="16" FontWeight="SemiBold" />
            <CheckBox IsChecked="{Binding YawAnimationEnabled}" Content="Yaw (Y) 360° loop" />
            <CheckBox IsChecked="{Binding PitchAnimationEnabled}" Content="Pitch (X) 360° loop" />
            <CheckBox IsChecked="{Binding RollAnimationEnabled}" Content="Roll (Z) 360° loop" />
            <TextBlock Text="{Binding ObjectRotationSummary}" TextWrapping="Wrap" Opacity="0.72" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock VerticalAlignment="Center" Text="View-relative Roll" />
              <Button Grid.Column="1" Click="ResetObject_Click" Content="Reset" />
            </Grid>
            <Slider Minimum="-180" Maximum="180" TickFrequency="1"
                    Value="{Binding ModelRollDegrees}" />
            <TextBlock Text="View mode: drag Local X/Y/Z rings or the white View Roll ring · Esc cancels"
                       TextWrapping="Wrap" Opacity="0.72" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Speed" />
              <TextBlock Grid.Column="1" Text="{Binding AnimationSpeed, StringFormat={}{0:0}°/s}" />
            </Grid>
            <Slider Minimum="5" Maximum="180" TickFrequency="5"
                    Value="{Binding AnimationSpeed}" />

            <Separator Margin="0,6" />
            <TextBlock Text="Lighting" FontSize="16" FontWeight="SemiBold" />
            <CheckBox IsChecked="{Binding LightingEnabled}" Content="4-step directional light" />
            <TextBlock Text="Directional light uses rotation only; position does not affect parallel light rays."
                       TextWrapping="Wrap" Opacity="0.72" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Rotation Y (Azimuth)" />
              <TextBlock Grid.Column="1" Text="{Binding LightAzimuth, StringFormat={}{0:0}°}" />
            </Grid>
            <Slider Minimum="-180" Maximum="180" TickFrequency="5"
                    Value="{Binding LightAzimuth}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Rotation X (Elevation)" />
              <TextBlock Grid.Column="1" Text="{Binding LightElevation, StringFormat={}{0:0}°}" />
            </Grid>
            <Slider Minimum="-90" Maximum="90" TickFrequency="5"
                    Value="{Binding LightElevation}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Ambient" />
              <TextBlock Grid.Column="1" Text="{Binding Ambient, StringFormat={}{0:0.00}}" />
            </Grid>
            <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                    Value="{Binding Ambient}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Intensity" />
              <TextBlock Grid.Column="1" Text="{Binding Intensity, StringFormat={}{0:0.00}}" />
            </Grid>
            <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                    Value="{Binding Intensity}" />

            <Separator Margin="0,6" />
            <TextBlock Text="Outline" FontSize="16" FontWeight="SemiBold" />
            <CheckBox IsChecked="{Binding OutlineEnabled}" Content="1px pixel outline" />
            <CheckBox IsChecked="{Binding IncludeDepthOutline}" Content="Include normal/depth edges" />
            <TextBlock Text="Color" />
            <ColorPicker Color="{Binding OutlineColor}" IsAlphaEnabled="False" />

            <Separator Margin="0,6" />
            <TextBlock Text="Background" FontSize="16" FontWeight="SemiBold" />
            <ColorPicker Color="{Binding BackgroundColor}" IsAlphaEnabled="False" />

            <Separator Margin="0,6" />
            <TextBlock Text="Sprite Export" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ExportSummary}" TextWrapping="Wrap" Opacity="0.72" />
            <TextBlock Text="Direction count" />
            <UniformGrid Columns="3">
              <Button Margin="2" Tag="4" Click="SelectExportDirectionCount_Click" Content="4" />
              <Button Margin="2" Tag="8" Click="SelectExportDirectionCount_Click" Content="8" />
              <Button Margin="2" Tag="16" Click="SelectExportDirectionCount_Click" Content="16" />
            </UniformGrid>
            <CheckBox IsChecked="{Binding ExportTrueIsometric}" Content="Use True Isometric camera" />
            <CheckBox IsChecked="{Binding ExportTransparentBackground}" Content="Transparent background" />
            <Button IsEnabled="{Binding CanExport}" Click="ExportCurrentView_Click" Content="Export Current View PNG..." />
            <Button IsEnabled="{Binding CanExport}" Click="ExportDirectionSheet_Click" Content="Export Direction Sheet + JSON..." />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Padding="8,4"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" />
    </Border>
  </Grid>
</Window>
